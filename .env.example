SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
SUPABASE_PUBLISHABLE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>
# Server-only — NEVER expose to client, NEVER commit real value
SUPABASE_SERVICE_ROLE_KEY=<SUBSTITUTE_SUPABASE_SERVICE_ROLE_KEY>
# Server-only owner allowlist UUID — never expose to client
SUPABASE_OWNER_ID=<SUBSTITUTE_OWNER_USER_UUID>

# WhatsApp (public — safe to expose, no PII beyond already-public number)
WHATSAPP_NUMBER=<SUBSTITUTE_WHATSAPP_NUMBER>
WHATSAPP_GREETING=Halo Nova! Saya tertarik dengan portofolio Anda.

# Public site URL used for canonical links, sitemap, and social cards
NUXT_PUBLIC_SITE_URL=https://novasugiantara.web.id

# Contact form delivery via Resend (server-only). Without these the form returns 503.
RESEND_API_KEY=<SUBSTITUTE_RESEND_API_KEY>
CONTACT_TO_EMAIL=<SUBSTITUTE_INBOX_EMAIL>
# Optional. Default sender only delivers to the Resend account's own email until a domain is verified.
CONTACT_FROM_EMAIL=Portfolio contact <onboarding@resend.dev>
