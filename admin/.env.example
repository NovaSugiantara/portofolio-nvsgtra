# Copy to admin/.env for local development. Never commit real values.

# Same Supabase project as the portfolio. Only the publishable key: every write is checked by
# owner-only RLS, so the admin never needs the service role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Where seeded relative paths such as /work/booking-engine.webp are previewed from.
PORTFOLIO_URL=https://novasugiantara.web.id

# Server-only. Vercel → portfolio project → Settings → Git → Deploy Hooks. Treat it as a secret:
# anyone with the URL can trigger builds.
DEPLOY_HOOK_PORTFOLIO=<SUBSTITUTE_VERCEL_DEPLOY_HOOK_URL>
DEPLOY_HOOK_FORGEBYTE=
